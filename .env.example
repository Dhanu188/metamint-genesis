# Copy to .env.local and fill in. .env.local is git-ignored.

# Deployed ERC-721 contract on Polygon Amoy (must expose safeMint(address,string) and tokenURI(uint256))
VITE_NFT_CONTRACT_ADDRESS=
# Block number the contract was deployed at (speeds up and bounds the gallery's log search)
VITE_NFT_DEPLOY_BLOCK=
# Optional: custom Amoy RPC (e.g. Alchemy). Defaults to the public Amoy RPC.
VITE_AMOY_RPC_URL=

# Pinata JWT for IPFS uploads. NOTE: VITE_ variables are bundled into the browser,
# so use a key scoped to pinFileToIPFS/pinJSONToIPFS only, and only for testnet use.
VITE_PINATA_JWT=
# Optional IPFS gateway used to display images
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
